From 7c9babd54562841097195285fe26cbc3d14bc4ae Mon Sep 17 00:00:00 2001
From: handrx <287708+handrx@users.noreply.github.com>
Date: Thu, 24 Sep 2026 14:41:40 +0100
Subject: [PATCH] pi5-v100 patches

---
 common/inc/nv-linux.h |  3 +++
 dkms.conf             | 23 +++++++++++++----------
 nvidia/nv-dma.c       |  6 ++----
 nvidia/nv-mmap.c      |  2 +-
 nvidia/nv.c           | 33 +++++++++++++++++++++++++++++++++
 nvidia/os-interface.c |  2 +-
 6 files changed, 53 insertions(+), 16 deletions(-)

diff --git a/common/inc/nv-linux.h b/common/inc/nv-linux.h
index 0b5b4bb..a07bdf8 100644
--- a/common/inc/nv-linux.h
+++ b/common/inc/nv-linux.h
@@ -1748,4 +1748,7 @@ typedef enum
 #define NV_CHECK_EXPORT_SYMBOL(symbol)  (NV_IS_EXPORT_SYMBOL_PRESENT_##symbol && \
                                          !NV_IS_EXPORT_SYMBOL_GPL_##symbol)
 
+extern int nv_pi5_no_iomap_wc;
+#define nv_pi5_disable_iomap_wc() (nv_pi5_no_iomap_wc || rm_disable_iomap_wc())
+
 #endif  /* _NV_LINUX_H_ */
diff --git a/dkms.conf b/dkms.conf
index aef54d3..fe581f7 100644
--- a/dkms.conf
+++ b/dkms.conf
@@ -1,12 +1,15 @@
 PACKAGE_NAME="nvidia"
-PACKAGE_VERSION="__VERSION_STRING"
+PACKAGE_VERSION="580.95.05-v100"
 AUTOINSTALL="yes"
-
-# By default, DKMS will add KERNELRELEASE to the make command line; however,
-# this will cause the kernel module build to infer that it was invoked via
-# Kbuild directly instead of DKMS. The dkms(8) manual page recommends quoting
-# the 'make' command name to suppress this behavior.
-MAKE[0]="'make' -j__JOBS NV_EXCLUDE_BUILD_MODULES='__EXCLUDE_MODULES' KERNEL_UNAME=${kernelver} modules"
-
-# The list of kernel modules will be generated by nvidia-installer at runtime.
-__DKMS_MODULES
+MAKE[0]="'make' -j$(nproc) SYSSRC=${kernel_source_dir} IGNORE_CC_MISMATCH=1 modules"
+CLEAN="make clean"
+BUILT_MODULE_NAME[0]="nvidia"
+DEST_MODULE_LOCATION[0]="/kernel/drivers/video"
+BUILT_MODULE_NAME[1]="nvidia-uvm"
+DEST_MODULE_LOCATION[1]="/kernel/drivers/video"
+BUILT_MODULE_NAME[2]="nvidia-modeset"
+DEST_MODULE_LOCATION[2]="/kernel/drivers/video"
+BUILT_MODULE_NAME[3]="nvidia-drm"
+DEST_MODULE_LOCATION[3]="/kernel/drivers/video"
+BUILT_MODULE_NAME[4]="nvidia-peermem"
+DEST_MODULE_LOCATION[4]="/kernel/drivers/video"
diff --git a/nvidia/nv-dma.c b/nvidia/nv-dma.c
index 2984af8..79bbe24 100644
--- a/nvidia/nv-dma.c
+++ b/nvidia/nv-dma.c
@@ -64,8 +64,7 @@ static NV_STATUS nv_dma_map_contig(
     *va = dma_map_page_attrs(dma_map->dev, dma_map->pages[0], 0,
                              dma_map->page_count * PAGE_SIZE,
                              DMA_BIDIRECTIONAL,
-                             (dma_map->cache_type == NV_MEMORY_UNCACHED) ?
-                              DMA_ATTR_SKIP_CPU_SYNC : 0);
+                             0 /* pi5-v100: never skip CPU sync */);
     if (dma_mapping_error(dma_map->dev, *va))
     {
         return NV_ERR_OPERATING_SYSTEM;
@@ -93,8 +92,7 @@ static void nv_dma_unmap_contig(nv_dma_map_t *dma_map)
     dma_unmap_page_attrs(dma_map->dev, dma_map->mapping.contig.dma_addr,
                          dma_map->page_count * PAGE_SIZE,
                          DMA_BIDIRECTIONAL,
-                         (dma_map->cache_type == NV_MEMORY_UNCACHED) ?
-                          DMA_ATTR_SKIP_CPU_SYNC : 0);
+                         0 /* pi5-v100: never skip CPU sync */);
 }
 
 static void nv_fill_scatterlist
diff --git a/nvidia/nv-mmap.c b/nvidia/nv-mmap.c
index 9ead01c..e52117c 100644
--- a/nvidia/nv-mmap.c
+++ b/nvidia/nv-mmap.c
@@ -568,7 +568,7 @@ int nvidia_mmap_helper(
             else
             {
                 if (nv_encode_caching(&vma->vm_page_prot,
-                        rm_disable_iomap_wc() ? NV_MEMORY_UNCACHED : mmap_context->caching, 
+                        nv_pi5_disable_iomap_wc() ? NV_MEMORY_UNCACHED : mmap_context->caching, 
                         NV_MEMORY_TYPE_FRAMEBUFFER))
                 {
                     if (nv_encode_caching(&vma->vm_page_prot,
diff --git a/nvidia/nv.c b/nvidia/nv.c
index 6becfec..b7fbbdf 100644
--- a/nvidia/nv.c
+++ b/nvidia/nv.c
@@ -32,6 +32,14 @@
 #include "nvmisc.h"
 #include "os-interface.h"
 #include "nv-linux.h"
+
+/* pi5-v100: workarounds for the non-cache-coherent Raspberry Pi 5 PCIe. */
+int nv_pi5_force_uncached = 1;
+module_param(nv_pi5_force_uncached, int, 0444);
+MODULE_PARM_DESC(nv_pi5_force_uncached, "Map all GPU-shared sysmem uncached (non-coherent PCIe)");
+int nv_pi5_no_iomap_wc = 1;
+module_param(nv_pi5_no_iomap_wc, int, 0444);
+MODULE_PARM_DESC(nv_pi5_no_iomap_wc, "Never map GPU MMIO write-combined");
 #include "nv-p2p.h"
 #include "nv-reg.h"
 #include "nv-msi.h"
@@ -3780,6 +3788,22 @@ void NV_API_CALL nv_free_kernel_mapping(
     }
 }
 
+#if defined(NVCPU_AARCH64)
+/* Clean + invalidate the linear-map alias of every page in the allocation. */
+static void nv_pi5_flush_alloc(struct device *dev, nv_alloc_t *at)
+{
+    NvU64 i;
+
+    for (i = 0; i < at->num_pages; i++)
+    {
+        dma_addr_t da = nv_phys_to_dma(dev, at->page_table[i].phys_addr);
+
+        dma_sync_single_for_device(dev, da, PAGE_SIZE, DMA_BIDIRECTIONAL);
+        dma_sync_single_for_cpu(dev, da, PAGE_SIZE, DMA_BIDIRECTIONAL);
+    }
+}
+#endif
+
 NV_STATUS NV_API_CALL nv_alloc_pages(
     nv_state_t *nv,
     NvU32       page_count,
@@ -3823,6 +3847,10 @@ NV_STATUS NV_API_CALL nv_alloc_pages(
         return NV_ERR_NO_MEMORY;
 
     at->cache_type = cache_type;
+#if defined(NVCPU_AARCH64)
+    if (nv_pi5_force_uncached && at->cache_type == NV_MEMORY_CACHED)
+        at->cache_type = NV_MEMORY_UNCACHED;
+#endif
 
     if (contiguous)
         at->flags.contig = NV_TRUE;
@@ -3879,6 +3907,11 @@ NV_STATUS NV_API_CALL nv_alloc_pages(
         }
     }
 
+#if defined(NVCPU_AARCH64)
+    if ((dev != NULL) && (at->cache_type != NV_MEMORY_CACHED) && !at->flags.coherent)
+        nv_pi5_flush_alloc(dev, at);
+#endif
+
     *priv_data = at;
     NV_ATOMIC_INC(at->usage_count);
 
diff --git a/nvidia/os-interface.c b/nvidia/os-interface.c
index fa668f5..c5c0f4b 100644
--- a/nvidia/os-interface.c
+++ b/nvidia/os-interface.c
@@ -944,7 +944,7 @@ void* NV_API_CALL os_map_kernel_space(
             vaddr = nv_ioremap_cache(start, size_bytes);
             break;
         case NV_MEMORY_WRITECOMBINED:
-            vaddr = rm_disable_iomap_wc() ?
+            vaddr = nv_pi5_disable_iomap_wc() ?
                     nv_ioremap_nocache(start, size_bytes) :
                     nv_ioremap_wc(start, size_bytes);
             break;
-- 
2.47.3

